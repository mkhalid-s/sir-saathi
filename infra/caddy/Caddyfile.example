sir-saathi.example {
    root * /srv/sir-saathi/web/current
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Cross-Origin-Resource-Policy same-origin
        Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'"
    }

    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        @pwaControl path /sw.js /manifest.webmanifest
        header @pwaControl Cache-Control "no-cache"

        @hashedAssets path /_astro/*
        header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

        file_server
    }
}
