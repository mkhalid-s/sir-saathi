sir-saathi.example {
    root * /srv/sir-saathi/web/current
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        @pwaControl path /sw.js /manifest.webmanifest
        header @pwaControl Cache-Control "no-cache"

        @hashedAssets path /_astro/*
        header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

        file_server
    }
}
