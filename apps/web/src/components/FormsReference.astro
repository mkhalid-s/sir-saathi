---
import { commonDocuments, forms } from '../data/forms';
import { translate, type MessageKey } from '../lib/i18n';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const message = (key: MessageKey) => translate(locale, key);
const formList = Object.values(forms);
const documentGroups = Object.entries(commonDocuments);
---
<section class="forms-reference" aria-labelledby="forms-reference-title">
  <div>
    <p class="eyebrow dark">{message('forms.eyebrow')}</p>
    <h2 id="forms-reference-title">{message('forms.title')}</h2>
    <p class="reference-copy">{message('forms.intro')}</p>
  </div>

  <div class="forms-list">
    {formList.map((form) => (
      <article class="form-card">
        <h3>{message(`forms.${form.formId}.label` as MessageKey)}</h3>
        <p>{message(`forms.${form.formId}.purpose` as MessageKey)}</p>
      </article>
    ))}
  </div>

  <div class="document-list">
    <h3>{message('forms.common_categories')}</h3>
    <ul>
      {documentGroups.map(([category, documents]) => (
        <li><strong>{message(`forms.category.${category}` as MessageKey)}:</strong> {documents.map((document) => {
          const matchingKey = Object.entries(commonDocuments).find(([, values]) => values.includes(document))?.[0] ?? category;
          return message(`document.${matchingKey}` as MessageKey);
        }).join(', ')}</li>
      ))}
    </ul>
  </div>
</section>
