---
import { statePath, states } from '../data/states';
import { jurisdictionName, localizedPath, translate, type MessageKey } from '../lib/i18n';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const message = (key: MessageKey, values: Record<string, string | number> = {}) => translate(locale, key, values);

function capabilityLabel(capability: string): string {
  return message(`capability.${capability}` as MessageKey);
}

function searchMessageKey(state: typeof states[number]): MessageKey {
  if (state.scheduleProvenance.confidence !== 'official') {
    return 'directory.search.unverified';
  }
  if (!state.publicLaunchReady) {
    return 'directory.search.not_ready';
  }
  if (state.capability === 'validated_indexed_search') {
    return 'directory.search.validated';
  }
  return 'directory.search.guidance';
}

const publicSearchCount = states.filter((state) => state.publicLaunchReady).length;
const reviewedScheduleCount = states.filter((state) => state.scheduleProvenance.confidence === 'official').length;
---
<section class="search-availability" aria-labelledby="search-availability-title">
  <div>
    <p class="eyebrow dark">{message('directory.eyebrow')}</p>
    <h2 id="search-availability-title">{message('directory.title')}</h2>
    <p class="reference-copy">{message('directory.intro')}</p>
  </div>

  <div class="coverage-summary" aria-label={message('directory.coverage_label')}>
    <div><strong>{states.length}</strong><span>{message('directory.covered')}</span></div>
    <div><strong>{reviewedScheduleCount}</strong><span>{message('directory.reviewed_schedules')}</span></div>
    <div><strong>{publicSearchCount}</strong><span>{message('directory.enabled_searches')}</span></div>
  </div>

  <details class="jurisdiction-directory">
    <summary>{message('directory.view_all', { count: states.length })}</summary>
    <div class="jurisdiction-list">
      {states.map((state) => (
        <article class="jurisdiction-row">
          <div>
            <h3>{jurisdictionName(locale, state.stateId)}</h3>
            <p class="source-note">{message(`status.${state.currentPhase}` as MessageKey)} · {message('directory.capability', { capability: capabilityLabel(state.capability) })}</p>
            <p class="source-note">{message('directory.provenance', { confidence: state.scheduleProvenance.confidence })}</p>
          </div>
          <div>
            <p>{message(searchMessageKey(state))}</p>
            <div class="jurisdiction-links">
              <a href={localizedPath(statePath(state), locale)}>{message('directory.view_guide', { state: jurisdictionName(locale, state.stateId) })}</a>
              <a href={state.officialLink} target="_blank" rel="noreferrer">{message('directory.official_portal')}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </details>
</section>
