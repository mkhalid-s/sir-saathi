---
import { states } from '../data/states';

function capabilityLabel(capability: string): string {
  return capability.replaceAll('_', ' ');
}

function searchMessage(state: typeof states[number]): string {
  if (state.scheduleProvenance.confidence !== 'official') {
    return 'Indexed public search remains off until the current schedule is verified from an official source. Use official portals and local BLO/ERO channels for final verification.';
  }
  if (!state.publicLaunchReady) {
    return 'Indexed public search is not launch-ready. Use official portals and local BLO/ERO channels for final verification.';
  }
  if (state.capability === 'validated_indexed_search') {
    return 'Validated indexed search can be enabled with abuse protection and scoped queries.';
  }
  return 'Guidance and official links are available; indexed search remains disabled.';
}

const publicSearchCount = states.filter((state) => state.publicLaunchReady).length;
const reviewedScheduleCount = states.filter((state) => state.scheduleProvenance.confidence === 'official').length;
---
<section class="search-availability" aria-labelledby="search-availability-title">
  <div>
    <p class="eyebrow dark">Search availability</p>
    <h2 id="search-availability-title">Search stays off until a state is safe to launch.</h2>
    <p class="reference-copy">SIR Saathi shows search capability transparently, but does not expose public indexed search until validation, privacy review, rate limits, and abuse checks pass.</p>
  </div>

  <div class="coverage-summary" aria-label="Nationwide coverage summary">
    <div><strong>{states.length}</strong><span>states and UTs covered</span></div>
    <div><strong>{reviewedScheduleCount}</strong><span>reviewed official schedules</span></div>
    <div><strong>{publicSearchCount}</strong><span>public indexed searches enabled</span></div>
  </div>

  <details class="jurisdiction-directory">
    <summary>View status for all {states.length} states and union territories</summary>
    <div class="jurisdiction-list">
      {states.map((state) => (
        <article class="jurisdiction-row">
          <div>
            <h3>{state.name}</h3>
            <p class="source-note">{state.status} · Capability: {capabilityLabel(state.capability)}</p>
            <p class="source-note">Schedule provenance: {state.scheduleProvenance.confidence}</p>
          </div>
          <div>
            <p>{searchMessage(state)}</p>
            <a href={state.officialLink} target="_blank" rel="noreferrer">Open official CEO portal</a>
          </div>
        </article>
      ))}
    </div>
  </details>
</section>
