---
import { localizedPath, translate, type MessageKey } from '../lib/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';

type PolicyPage = 'privacy' | 'methodology' | 'data-use' | 'accessibility';

interface Props {
  page: PolicyPage;
  locale: string;
}

const { page, locale } = Astro.props;
const message = (key: MessageKey) => translate(locale, key);
const privacyItems: MessageKey[] = [
  'privacy.item.accounts', 'privacy.item.uploads', 'privacy.item.raw',
  'privacy.item.search', 'privacy.item.provenance', 'privacy.item.share'
];
const methodologyItems: MessageKey[] = [
  'methodology.item.sources', 'methodology.item.confirm', 'methodology.item.guidance',
  'methodology.item.promote', 'methodology.item.fallback', 'methodology.item.share'
];
const accessibilityFeatures: MessageKey[] = [
  'accessibility.feature.keyboard', 'accessibility.feature.structure', 'accessibility.feature.reflow',
  'accessibility.feature.visual', 'accessibility.feature.motion', 'accessibility.feature.offline',
  'accessibility.feature.language'
];
const accessibilityLimitations: MessageKey[] = [
  'accessibility.limitation.manual', 'accessibility.limitation.languages', 'accessibility.limitation.external'
];
---
<main class="shell content-page" id="main-content">
  <LocaleSwitcher locale={locale} currentPath={`/${page}/`} />
  {page === 'privacy' && (
    <>
      <h1>{message('privacy.title')}</h1>
      <p>{message('privacy.intro')}</p>
      <ul>{privacyItems.map((key) => <li>{message(key)}</li>)}</ul>
      <p>{message('privacy.closing')}</p>
    </>
  )}
  {page === 'methodology' && (
    <>
      <h1>{message('methodology.title')}</h1>
      <p>{message('methodology.intro')}</p>
      <ol>{methodologyItems.map((key) => <li>{message(key)}</li>)}</ol>
    </>
  )}
  {page === 'data-use' && (
    <>
      <h1>{message('data_use.title')}</h1>
      <p>{message('data_use.public_risk')}</p>
      <p>{message('data_use.prohibited')}</p>
      <p>{message('data_use.purpose')}</p>
      <p>{message('data_use.launch')}</p>
      <p>{message('data_use.share')}</p>
    </>
  )}
  {page === 'accessibility' && (
    <>
      <h1>{message('accessibility.title')}</h1>
      <p>{message('accessibility.intro')}</p>
      <p>{message('accessibility.target')}</p>
      <p class="notice">{message('accessibility.not_conformance')}</p>
      <h2>{message('help.using_title')}</h2>
      <ol>
        <li>{message('help.use_find')}</li>
        <li>{message('help.use_guidance')}</li>
        <li>{message('help.use_official')}</li>
        <li>{message('help.use_offline')}</li>
      </ol>
      <h2>{message('accessibility.features_title')}</h2>
      <ul>{accessibilityFeatures.map((key) => <li>{message(key)}</li>)}</ul>
      <h2>{message('accessibility.limitations_title')}</h2>
      <ul>{accessibilityLimitations.map((key) => <li>{message(key)}</li>)}</ul>
      <h2>{message('accessibility.report_title')}</h2>
      <p>{message('accessibility.report_intro')}</p>
      <p class="notice">{message('accessibility.report_unavailable')}</p>
      <p class="notice">{message('accessibility.report_privacy')}</p>
      <p><a href={`${localizedPath('/', locale)}#official-assistance-title`}>{message('accessibility.official_help')}</a></p>
      <h2>{message('accessibility.standards_title')}</h2>
      <ul>
        <li><a href="https://guidelines.india.gov.in/help/" target="_blank" rel="noreferrer">{message('accessibility.gigw')}</a></li>
        <li><a href="https://www.w3.org/TR/WCAG22/" target="_blank" rel="noreferrer">{message('accessibility.wcag')}</a></li>
      </ul>
      <h2>{message('help.map_title')}</h2>
      <nav aria-label={message('help.map_title')}>
        <ul>
          <li><a href={localizedPath('/', locale)}>{message('help.map_home')}</a></li>
          <li><a href={`${localizedPath('/', locale)}#search-availability-title`}>{message('help.map_states')}</a></li>
          <li><a href={localizedPath('/languages/', locale)}>{message('nav.language_status')}</a></li>
          <li><a href={localizedPath('/privacy/', locale)}>{message('nav.privacy')}</a></li>
          <li><a href={localizedPath('/methodology/', locale)}>{message('nav.methodology')}</a></li>
          <li><a href={localizedPath('/data-use/', locale)}>{message('nav.data_use')}</a></li>
        </ul>
      </nav>
    </>
  )}
  <p><a href={localizedPath('/', locale)}>{message('nav.back_home')}</a></p>
</main>
