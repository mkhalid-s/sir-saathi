---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StateContent from '../../components/StateContent.astro';
import { states, type StateSummary } from '../../data/states';
import { jurisdictionName, translate } from '../../lib/i18n';

export function getStaticPaths() {
  return states.map((state) => ({
    params: { stateId: state.stateId.toLowerCase() },
    props: { state }
  }));
}

interface Props {
  state: StateSummary;
}

const { state } = Astro.props;
---
<BaseLayout
  title={translate('en', 'state.meta.title', { state: jurisdictionName('en', state.stateId) })}
  description={translate('en', 'state.meta.description', { state: jurisdictionName('en', state.stateId) })}
  path={`/states/${state.stateId.toLowerCase()}/`}
>
  <StateContent state={state} locale="en" />
</BaseLayout>
